# =============================================================================
# Dockerfile.edge  —  Imagen LIGERA para dispositivos edge
# -----------------------------------------------------------------------------
# Mismo pipeline y mismo código, pero:
#   * SIN TensorFlow: usa LiteRT (runtime de TensorFlow Lite, ~30 MB en vez de ~600 MB).
#   * Modelo .tflite con pesos cuantizados a int8 (~290 KB en vez de 3.4 MB).
#   * Perfil config/config_edge.yaml: 1 hilo de CPU y lotes pequeños.
# Construir:   docker build -f Dockerfile.edge -t vision-figuras:1.0-edge .
# Simular un dispositivo pequeño (medio núcleo y 256 MB de RAM):
#   docker run -p 8000:8000 --cpus=0.5 --memory=256m vision-figuras:1.0-edge
# =============================================================================

ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIPELINE_CONFIG=config/config_edge.yaml

WORKDIR /app

RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
COPY requirements-edge.txt requirements-api.txt ./
# Redes corporativas (proxy o antivirus que inspecciona HTTPS): el certificado raíz de la empresa
# se pasa como SECRETO de BuildKit. Se usa solo durante este paso y NO queda guardado en la imagen.
#   docker build --secret id=ca_corporativa,src=certs/ca-windows.pem ...
# Sin el secreto, el paso funciona igual que siempre.
RUN --mount=type=secret,id=ca_corporativa \
    if [ -s /run/secrets/ca_corporativa ]; then \
        cat /etc/ssl/certs/ca-certificates.crt /run/secrets/ca_corporativa > /tmp/ca.pem; \
        export PIP_CERT=/tmp/ca.pem; \
    fi; \
    pip install -r requirements-edge.txt -r requirements-api.txt && rm -f /tmp/ca.pem

# Solo los modelos .tflite (no se copia el .keras ni TensorFlow)
COPY config/ config/
COPY models/clases.txt models/model_card.json models/*.tflite models/
COPY src/ src/
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
# Si el repositorio se clonó en Windows, el script puede venir con fin de línea CRLF:
# se convierte a LF y se marca como ejecutable para que Linux lo pueda ejecutar.
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh

RUN useradd --create-home --uid 1000 app && mkdir -p outputs data && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=4)" || exit 1

ENTRYPOINT ["entrypoint.sh"]
CMD ["api"]
